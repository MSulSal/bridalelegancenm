# Public base URL for canonical metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Denver

# Boutique availability windows, in local Google Calendar time.
# Format: HH:MM-HH:MM or comma-separated windows like 10:00-14:00,15:00-18:00
APPOINTMENT_HOURS_SUNDAY=
APPOINTMENT_HOURS_MONDAY=
APPOINTMENT_HOURS_TUESDAY=
APPOINTMENT_HOURS_WEDNESDAY=
APPOINTMENT_HOURS_THURSDAY=
APPOINTMENT_HOURS_FRIDAY=
APPOINTMENT_HOURS_SATURDAY=
APPOINTMENT_DURATION_MINUTES=90
APPOINTMENT_LEAD_DAYS=1
APPOINTMENT_MAX_DAYS_AHEAD=120

# Optional Formspree fallback (legacy)
FORMSPREE_APPOINTMENT_ENDPOINT=

# Square Payments API (currently archived / not required for launch)
# Keep these available if payments are re-enabled later.
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=USD
SQUARE_API_VERSION=2026-01-22

# Cloudinary (required to host inspiration photos so SMS can include them)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_APPOINTMENT_FOLDER=bridal-elegance-appointments

# Notification delivery mode:
# both = email + text (requires Resend + Twilio + Cloudinary)
# text = text only (requires Twilio + Cloudinary; sends hosted image URLs in SMS body)
# email = email only (requires Resend + Cloudinary)
APPOINTMENT_NOTIFICATION_MODE=both

# Resend (notification email delivery)
RESEND_API_KEY=
APPOINTMENT_NOTIFICATION_EMAIL_FROM=appointments@bridalelegancenm.com
# comma-separated if multiple recipients
APPOINTMENT_NOTIFICATION_EMAIL_TO=

# Twilio (notification SMS/MMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
APPOINTMENT_NOTIFICATION_SMS_TO=
